# Required for KI-Scan
OPENAI_API_KEY=

# Optional model overrides
OPENAI_SINGLE_MODEL=gpt-4o-mini
OPENAI_MULTI_MODEL=gpt-4o

# Optional Pokemon TCG API key for higher API limits and server-side Cardmarket price data
POKEMON_TCG_API_KEY=

# Required for Neon cloud sync and login sessions
DATABASE_URL=

# Required setup/admin code.
# Use this once when creating the first account in the app.
# After that you sign in with username + password; the app uses an HttpOnly session cookie.
APP_ACCESS_TOKEN=

# Optional direct Cardmarket credentials for a future official backend integration.
# Never expose these in frontend code.
CARDMARKET_API_KEY=
CARDMARKET_API_SECRET=
CARDMARKET_API_TOKEN=

# Optional scan/search/price protection tuning
SCAN_MAX_PER_HOUR=80
SEARCH_MAX_PER_HOUR=300
PRICE_MAX_PER_HOUR=240
SCAN_MAX_IMAGE_BYTES=4500000
PRICE_CACHE_TTL_SECONDS=3600
PRICE_FETCH_TIMEOUT_MS=6500
