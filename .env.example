# Required for KI-Scan
OPENAI_API_KEY=

# Optional model overrides
OPENAI_SINGLE_MODEL=gpt-4o-mini
OPENAI_MULTI_MODEL=gpt-4o

# Optional Pokemon TCG API key for higher API limits
POKEMON_TCG_API_KEY=

# Required for Neon cloud sync
DATABASE_URL=

# Strong shared token for Cloud-Sync and protected API calls.
# Do not commit the real value. Set it in Vercel Environment Variables.
APP_ACCESS_TOKEN=

# Optional scan protection tuning
SCAN_MAX_PER_HOUR=80
SCAN_MAX_IMAGE_BYTES=4500000
